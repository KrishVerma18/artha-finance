# Artha Finance Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (e.g. mongodb://localhost:27017/artha or MongoDB Atlas URI)
# In development, if no local/remote MongoDB instance is reachable, Artha automatically uses an embedded datastore!
MONGODB_URI=mongodb://localhost:27017/artha_finance

# JWT Configuration
JWT_SECRET=artha_finance_super_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d

# Google OAuth (Optional / Demo supported)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMS OTP Provider
OTP_EXPIRY_MINUTES=5
